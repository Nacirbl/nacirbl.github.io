{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "University of Twente Assignment PDF Metadata",
  "description": "Schema for metadata embedded in assignment submission PDFs",
  "type": "object",
  "required": ["generatedAt", "title", "student", "questionCount", "questions"],
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when the PDF was generated"
    },
    "title": {
      "type": "string",
      "description": "Title of the assignment"
    },
    "instructions": {
      "type": "string",
      "description": "General instructions for the assignment",
      "default": ""
    },
    "student": {
      "type": "object",
      "required": ["date"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Student's full name"
        },
        "snumber": {
          "type": "string",
          "pattern": "^s\\d{7}$",
          "description": "Student number in format s1234567"
        },
        "group": {
          "type": "string",
          "description": "Student's group/class identifier"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "Date of submission in YYYY-MM-DD format"
        }
      }
    },
    "questionCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of questions in the assignment"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["questionNumber", "questionText", "answerHTML", "answerPlainText"],
        "properties": {
          "questionNumber": {
            "type": "integer",
            "minimum": 1,
            "description": "Sequential question number"
          },
          "questionText": {
            "type": "string",
            "description": "The question text"
          },
          "questionDescription": {
            "type": "string",
            "description": "Additional description or requirements for the question",
            "default": ""
          },
          "answerHTML": {
            "type": "string",
            "description": "Full HTML content of the answer including formatting and base64 images"
          },
          "answerPlainText": {
            "type": "string",
            "description": "Plain text version of the answer without formatting"
          },
          "uploadedImage": {
            "type": ["string", "null"],
            "pattern": "^data:image/(jpeg|png|gif|webp);base64,",
            "description": "Base64-encoded uploaded image file, if any"
          }
        }
      }
    }
  }
}